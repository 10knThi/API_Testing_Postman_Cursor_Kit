        {
          "name": "Dashboard không truyền fiscal_year",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/admin/dashboard",
            "description": "A10. fiscal_year optional. Expected 200 và đủ schema. Không assert năm mặc định."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type chứa application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Envelope và các field bắt buộc của data', function () {",
                  "    pm.expect(body.message).to.be.a('string');",
                  "    pm.expect(body.errors).to.eql(null);",
                  "    pm.expect(body.meta).to.be.an('object');",
                  "    ['fiscal_year', 'available_fiscal_years', 'summary', 'trends', 'monthly_details'].forEach(function (key) {",
                  "        pm.expect(body.data).to.have.property(key);",
                  "    });",
                  "    pm.expect(Number.isInteger(body.data.fiscal_year)).to.eql(true);",
                  "    pm.expect(body.data.available_fiscal_years).to.be.an('array');",
                  "    body.data.available_fiscal_years.forEach(function (year) {",
                  "        pm.expect(Number.isInteger(year)).to.eql(true);",
                  "    });",
                  "    pm.expect(body.data).to.not.have.property('password');",
                  "});",
                  "",
                  "pm.test('summary đúng kiểu', function () {",
                  "    const summary = body.data.summary;",
                  "    ['new_contracts', 'cancellations', 'net_increase'].forEach(function (key) {",
                  "        pm.expect(Number.isInteger(summary[key])).to.eql(true);",
                  "    });",
                  "    const retention = summary.net_retention;",
                  "    pm.expect(retention === null || typeof retention === 'number').to.eql(true);",
                  "});",
                  "",
                  "pm.test('trends và monthly_details đúng cấu trúc', function () {",
                  "    const trends = body.data.trends;",
                  "    pm.expect(trends.monthly_contracts).to.be.an('array');",
                  "    pm.expect(trends.monthly_staff).to.be.an('array');",
                  "    pm.expect(body.data.monthly_details).to.be.an('array');",
                  "    trends.monthly_contracts.forEach(function (row) {",
                  "        ['month', 'new_contracts', 'cancellations', 'total_contracted'].forEach(function (key) {",
                  "            pm.expect(Number.isInteger(row[key])).to.eql(true);",
                  "        });",
                  "    });",
                  "    trends.monthly_staff.forEach(function (row) {",
                  "        ['month', 'new_staff', 'total_staff'].forEach(function (key) {",
                  "            pm.expect(Number.isInteger(row[key])).to.eql(true);",
                  "        });",
                  "    });",
                  "    body.data.monthly_details.forEach(function (row) {",
                  "        ['month', 'new', 'trial', 'cancellation', 'net_increase', 'contracting_companies', 'registered_staff', 'contracted_accounts'].forEach(function (key) {",
                  "            pm.expect(Number.isInteger(row[key])).to.eql(true);",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
