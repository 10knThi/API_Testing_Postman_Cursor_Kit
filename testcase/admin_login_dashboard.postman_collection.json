{
  "info": {
    "name": "Admin Login + Dashboard API",
    "description": "POST /api/admin/auth/login và GET /api/admin/dashboard. Nguồn expected: basic design/document.json và assumption A1–A12 đã chốt. Credential lấy từ environment Welvie STG ({{base_url}}, {{admin_email}}, {{admin_password}}). Không hard-code mật khẩu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api-dev.stg.welvielearning.com"
    },
    {
      "key": "admin_email",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login thành công",
      "item": [
        {
          "name": "Login hợp lệ và lưu access_token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/admin/auth/login",
            "description": "Positive. Password của account này dài 8 ký tự, đúng minLength. Expected 200 theo Login response. Token lấy từ data.access_token (A4)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type chứa application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Envelope 200', function () {",
                  "    pm.expect(response.message).to.be.a('string');",
                  "    pm.expect(response.errors).to.eql(null);",
                  "    pm.expect(response.meta).to.be.an('object');",
                  "    pm.expect(response.data).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('data.access_token tồn tại và đúng kiểu', function () {",
                  "    pm.expect(response.data.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.data.refresh_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.data.type_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(Number.isInteger(response.data.expires_in)).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Response không chứa password, hash, secretKey', function () {",
                  "    pm.expect(response).to.not.have.property('password');",
                  "    pm.expect(response.data).to.not.have.property('password');",
                  "    pm.expect(response.data).to.not.have.property('hash');",
                  "    pm.expect(response.data).to.not.have.property('secretKey');",
                  "});",
                  "",
                  "const token = response.data && response.data.access_token;",
                  "if (typeof token === 'string' && token.length > 0) {",
                  "    pm.collectionVariables.set('access_token', token);",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
